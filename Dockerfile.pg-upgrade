FROM postgres:17.11-bookworm@sha256:839fbb5a4942a7758dd93e18b42ea5649807491a0545b5eeeb8f0b8bb11857a5

# Install PostgreSQL 14 alongside PostgreSQL 17
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        postgresql-common \
    && rm -rf /var/lib/apt/lists/*


# Expected PostgreSQL APT repository signing key
ARG POSTGRES_GPG_FINGERPRINT=B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8

# Download and verify PostgreSQL signing key
RUN set -eu; \
    curl -fsSL \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /tmp/postgresql.asc; \
    actual_fingerprint="$( \
        gpg --batch --show-keys --with-colons /tmp/postgresql.asc \
        | awk -F: '$1 == "fpr" {print $10; exit}' \
    )"; \
    echo "Expected fingerprint: ${POSTGRES_GPG_FINGERPRINT}"; \
    echo "Actual fingerprint:   ${actual_fingerprint}"; \
    test "${actual_fingerprint}" = "${POSTGRES_GPG_FINGERPRINT}"; \
    install -d /usr/share/postgresql-common/pgdg; \
    install -m 644 /tmp/postgresql.asc \
        /usr/share/postgresql-common/pgdg/apt.asc; \
    rm /tmp/postgresql.asc

# Configure PostgreSQL APT repository
RUN echo \
    "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
    > /etc/apt/sources.list.d/pgdg.list

# Expected TimescaleDB repository signing key
ARG TIMESCALEDB_GPG_FINGERPRINT=1005FB68604CE9B8F6879CF759F18EDF47F24417

# Download and verify TimescaleDB signing key
RUN set -eu; \
    curl -fsSL \
        https://packagecloud.io/timescale/timescaledb/gpgkey \
        -o /tmp/timescaledb.asc; \
    actual_fingerprint="$( \
        gpg --batch --show-keys --with-colons /tmp/timescaledb.asc \
        | awk -F: '$1 == "fpr" {print $10; exit}' \
    )"; \
    echo "Expected fingerprint: ${TIMESCALEDB_GPG_FINGERPRINT}"; \
    echo "Actual fingerprint:   ${actual_fingerprint}"; \
    test "${actual_fingerprint}" = "${TIMESCALEDB_GPG_FINGERPRINT}"; \
    gpg --batch --yes --dearmor \
        -o /usr/share/keyrings/timescaledb.gpg \
        /tmp/timescaledb.asc; \
    chmod 644 /usr/share/keyrings/timescaledb.gpg; \
    rm /tmp/timescaledb.asc

# Configure TimescaleDB APT repository
RUN echo \
    "deb [signed-by=/usr/share/keyrings/timescaledb.gpg] https://packagecloud.io/timescale/timescaledb/debian/ bookworm main" \
    > /etc/apt/sources.list.d/timescaledb.list

# Install PostgreSQL 14 and TimescaleDB 2.19.3 for both versions
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-14 \
        timescaledb-2-loader-postgresql-14 \
        timescaledb-2-loader-postgresql-17 \
        'timescaledb-2-2.19.3-postgresql-14=2.19.3~debian12' \
        'timescaledb-2-2.19.3-postgresql-17=2.19.3~debian12' \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /upgrade
